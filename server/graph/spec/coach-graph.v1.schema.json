{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumina.local/schemas/coach-graph.v1.schema.json",
  "title": "Lumina coach graph spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_id", "version", "nodes", "edges"],
  "properties": {
    "spec_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "task_type", "max_steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["worker", "supervisor", "hitl", "terminal"] },
        "task_type": {
          "type": "string",
          "enum": ["tutor-chat", "deep-reasoning", "grading", "self-critique", "cheap-classify", "embedding"]
        },
        "max_steps": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "enum": ["interrupt"] },
        "subgraph": { "type": "boolean" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "condition_id", "condition_expr", "priority"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition_id": { "type": "string", "minLength": 1 },
        "condition_expr": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" }
      }
    }
  }
}
